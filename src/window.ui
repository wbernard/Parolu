<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="ParoluWindow" parent="AdwApplicationWindow">
    <property name="default-width">700</property>
    <property name="default-height">300</property>
    <property name="title">Parolu</property>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar" id="header_bar">
            <child type="start">
              <object class="GtkButton" id="open_button">
                <property name="icon-name">document-open</property>
                <property name="tooltip-text" translatable="yes">Open Text File</property>
                <property name="action-name">win.open</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="save_text_button">
                <property name="icon-name">document-save</property>
                <property name="tooltip-text" translatable="yes">Save Text to File</property>
                <property name="action-name">win.save-as</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton">
                <property name="primary">True</property>
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text" translatable="yes">Menu</property>
                <property name="menu-model">primary_menu</property>
              </object>
            </child>

          </object>
        </child>

        <child type="bottom">
          <object class="GtkBox">
            <property name="spacing">12</property>
            <property name="margin-start">6</property>
            <property name="margin-end">6</property>
            <property name="hexpand">true</property>

            <child>
              <object class="GtkBox">
                <property name="orientation">0</property>
                <property name="margin-top">12</property>
                <property name="margin-bottom">12</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <property name="halign">GTK_ALIGN_START</property>
                <property name="spacing">6</property>

                <child type="start">
                  <object class="GtkDropDown" id="lang_chooser">
                    <property name="enable-search">false</property>
                    <property name="tooltip-text" translatable="yes">Choose Language</property>
                    <property name="valign">center</property>
                    <signal name="notify::selected" handler="on_lang_changed"/>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item>Esperanto</item>
                          <item>Deutsch</item>
                          <item>Italiano</item>
                          <item>Español</item>
                          <item>Francais</item>
                          <item>Português Brasileiro</item>
                          <item>Nederlands</item>
                          <item>English</item>
                          <item>Català</item>
                          <item>Čeština</item>
                          <item>Cymraeg</item>
                          <item>Dansk</item>
                          <item>Ελληνικά</item>
                          <item>Suomi</item>
                          <item>हिन्दी</item>
                          <item>Magyar</item>
                          <item>Íslenska</item>
                          <item>ქართული</item>
                          <item>Қазақша</item>
                          <item>Lëtzebuergesch</item>
                          <item>Latviešu</item>
                          <item>മലയാളം</item>
                          <item>नेपाली</item>
                          <item>Norsk</item>
                          <item>Polski</item>
                          <item>Română</item>
                          <item>Русский</item>
                          <item>Slovenčina</item>
                          <item>Slovenščina</item>
                          <item>Српски</item>
                          <item>Svenska</item>
                          <item>Kiswahili</item>
                          <item>Türkçe</item>
                          <item>Українська</item>
                          <item>Tiếng Việt</item>
                          <item>简体中文</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="GtkDropDown" id="voice_chooser">
                    <property name="enable-search">false</property>
                    <property name="tooltip-text" translatable="yes">Choose Voice</property>
                    <property name="valign">GTK_ALIGN_CENTER</property>
                    <signal name="notify::selected" handler="on_voice_download_selected"/>
                  </object>
                </child>

              </object>
            </child>

            <child>
              <object class="GtkBox">
                <property name="orientation">0</property>
                <property name="margin-top">12</property>
                <property name="margin-bottom">12</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <property name="halign">GTK_ALIGN_START</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkMenuButton" id="pitch_button">
                    <property name="tooltip-text" translatable="yes">Adjust Pitch</property>
                    <property name="valign">GTK_ALIGN_CENTER</property>

                    <style>
                      <class name="flat"/>
                      <class name="numeric"/>
                    </style>

                    <child>
                      <object class="GtkBox">
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">im.bernard.Parolu.pitch-symbolic</property>
                            <property name="margin-end">6</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label_1">
                            <property name="label">× 1.0</property>
                          </object>
                        </child>
                      </object>
                    </child>

                    <property name="popover">
                      <object class="GtkPopover">
                        <child>
                          <object class="GtkBox">
                            <property name="margin-start">4</property>
                            <property name="margin-end">4</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                            <property name="spacing">4</property>
                            <property name="orientation">1</property>
                            <child>
                              <object class="GtkScale" id="pitch_chooser">
                                <property name="height-request">200</property>
                                <property name="vexpand">true</property>
                                <property name="orientation">1</property>
                                <property name="inverted">true</property>
                                <property name="adjustment">
                                  <object class="GtkAdjustment" id="adjustment_1">
                                    <property name="step-increment">0.5</property>
                                    <property name="lower">0.4</property>
                                    <property name="upper">1.8</property>
                                    <property name="value">1</property>
                                  </object>
                                </property>
                                <signal name="change-value" handler="scale_change_value_cb"/>
                                <marks>
                                  <mark value="0.5" position="bottom"></mark>
                                  <mark value="1" position="bottom"></mark>
                                  <mark value="2" position="bottom"></mark>
                                  <mark value="3" position="bottom"></mark>
                                </marks>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>

                  </object>
                </child>

                <child>
                  <object class="GtkMenuButton" id="speed_button">
                    <property name="tooltip-text" translatable="yes">Adjust Speed</property>
                    <property name="valign">GTK_ALIGN_CENTER</property>

                    <style>
                      <class name="flat"/>
                      <class name="numeric"/>
                    </style>

                    <child>
                      <object class="GtkBox">
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">im.bernard.Parolu.speed-symbolic</property>
                            <property name="margin-end">6</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label_2">
                            <property name="label">× 1.0</property>
                          </object>
                        </child>
                      </object>
                    </child>

                    <property name="popover">
                      <object class="GtkPopover">
                        <child>
                          <object class="GtkBox">
                            <property name="margin-start">4</property>
                            <property name="margin-end">4</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                            <property name="spacing">4</property>
                            <property name="orientation">1</property>
                            <child>
                              <object class="GtkScale" id="speed_chooser">
                                <property name="height-request">200</property>
                                <property name="vexpand">true</property>
                                <property name="orientation">1</property>
                                <property name="inverted">true</property>
                                <property name="adjustment">
                                  <object class="GtkAdjustment" id="adjustment_2">
                                    <property name="step-increment">0.5</property>
                                    <property name="lower">0.1</property>
                                    <property name="upper">2</property>
                                    <property name="value">1</property>
                                  </object>
                                </property>
                                <signal name="change-value" handler="scale_change_value_cb"/>
                                <marks>
                                  <mark value="0.5" position="bottom"></mark>
                                  <mark value="1" position="bottom"></mark>
                                  <mark value="2" position="bottom"></mark>
                                  <mark value="3" position="bottom"></mark>
                                </marks>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox">
                <property name="orientation">0</property>
                <property name="margin-top">12</property>
                <property name="margin-bottom">12</property>
                <property name="margin-start">12</property>
                <property name="margin-end">6</property>
                <property name="halign">GTK_ALIGN_END</property>
                <property name="hexpand">true</property>
                <property name="spacing">6</property>

                <child type="end">
                  <object class="GtkButton" id="save_button">
                    <property name="tooltip-text" translatable="yes">Save Audio to File</property>
                    <property name="icon-name">document-save</property>
                    <property name="valign">GTK_ALIGN_CENTER</property>
                  </object>
                </child>

                <child>
                  <object class="GtkButton" id="read_button">
                    <property name="icon-name">media-playback-start-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Read Text</property>
                    <signal name="clicked" handler="read_text" swapped="no"/>
                  </object>
                </child>

              </object>
            </child>



          </object>
        </child>

        <property name="content">
          <object class="GtkScrolledWindow">
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <property name="margin-top">0</property>
            <property name="margin-bottom">0</property>
            <property name="margin-start">0</property>
            <property name="margin-end">0</property>
            <property name="child">
              <object class="GtkTextView" id="main_text_view">
                <property name="top-margin">6</property>
                <property name="bottom-margin">12</property>
                <property name="left-margin">12</property>
                <property name="right-margin">12</property>
                <property name="wrap-mode">GTK_WRAP_WORD_CHAR</property>
              </object>
            </property>

          </object>
        </property>
      </object>
    </property>
  </template>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">win.show-help-overlay</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About Parolu</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>

