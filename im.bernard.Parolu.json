{
    "id": "im.bernard.Parolu",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "parolu",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--socket=pulseaudio"
    ],
    "cleanup-commands": [
        "python3 -m compileall --invalidation-mode=unchecked-hash /app"
    ],    
    "modules": [
        "pip-dependencies.json",
        {
            "name": "parolu",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
