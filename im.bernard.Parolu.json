{
    "id": "im.bernard.Parolu",
    "runtime": "org.gnome.Platform",
    "runtime-version": "49",
    "sdk": "org.gnome.Sdk",
    "command": "parolu",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--socket=pulseaudio"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "build-options" : {
        "env" : {
            "ONNX_ROOT" : "/app/onnx_root"
        },
        "build-args": [
            "--share=network"
        ]
    },
    "modules": [
        "pip-dependencies.json",
        {
            "name": "piper-model-ludoviko",
            "buildsystem": "simple",
            "build-commands": [
            	"mkdir -p /app/share/piper/eo/eo-ludoviko-medium",
        	"wget -O /app/share/piper/eo/eo-ludoviko-medium/eo-ludoviko-medium.onnx https://raw.githubusercontent.com/wbernard/Parolu/main/models/eo/eo-ludoviko-medium/eo-ludoviko-medium.onnx",
        	"wget -O /app/share/piper/eo/eo-ludoviko-medium/p eo-ludoviko-medium.onnx.json https://raw.githubusercontent.com/wbernard/Parolu/main/models/eo/eo-ludoviko-medium/eo-ludoviko-medium.onnx.json"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/wbernard/Parolu/main/models/eo/eo-ludoviko-medium/eo-ludoviko-medium.onnx",
                    "sha256": "db505438a5364e8e2e0242c4324130a873ed660dfbe8d9689cef428ffb1b645f"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/wbernard/Parolu/main/models/eo/eo-ludoviko-medium/eo-ludoviko-medium.onnx.json",
                    "sha256": "6c70278e89055ebdcb23a83b60626baf31dd13651c1e03dbfda7c4bd152c63e9"

                }
            ]
        },
        {
            "name": "piper-model-gosia",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/share/piper/eo/eo-gosia-medium",
        	"wget -O /app/share/piper/eo/eo-gosia-medium/eo-gosia-medium.onnx https://raw.githubusercontent.com/wbernard/Parolu/main/models/eo/eo-gosia-medium/eo-gosia-medium.onnx",
        	"wget -O /app/share/piper/eo/eo-gosia-medium/p eo-gosia-medium.onnx.json https://raw.githubusercontent.com/wbernard/Parolu/main/models/eo/eo-gosia-medium/eo-gosia-medium.onnx.json"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://raw.githubusercontent.com/wbernard/Parolu/main/models/eo/eo-gosia-medium/eo-gosia-medium.onnx",
                    "sha256": "38f66464240ed74f186e6b7dc13c6e3b22e023426299f25c2b3cc9dfa9373fbc"
                },
                {
                    "type": "archive",
                    "url": "https://raw.githubusercontent.com/wbernard/Parolu/main/models/eo/eo-gosia-medium/eo-gosia-medium.onnx.json",
                    "sha256": "1aefb31a9d53ffe44a8163ff73ec833acb7a6253848f6bb0403d8a66f9c7510d"
                }
            ]
        },
        {
            "name": "parolu",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
